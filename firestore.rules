rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Default Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Core Reusable Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email == "ibrarahmadansare@gmail.com" && request.auth.token.email_verified == true)
      );
    }

    // 1. Admins lookup collection (read-only for self/admin, never client-writable)
    match /admins/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();
      allow create, update, delete: if false;
    }

    // 2. Users collection
    match /users/{uid} {
      allow read: if isSignedIn();

      // Public registration can ONLY assign 'student' or 'teacher'
      allow create: if isOwner(uid)
        && isValidId(uid)
        && request.resource.data.role in ['student', 'teacher']
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 100
        && request.resource.data.email is string
        && request.resource.data.email.size() >= 3
        && request.resource.data.email.size() <= 254;

      // Users can update their own profile but can NEVER change their role; admins can manage profiles
      allow update: if (
        isOwner(uid)
        && request.resource.data.role == resource.data.role
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 100
      ) || isAdmin();

      allow delete: if isOwner(uid) || isAdmin();
    }

    // 3. Student-Teacher & Peer Connection Requests collection
    match /connectionRequests/{requestId} {
      allow get: if isSignedIn() && (
        resource == null ||
        resource.data.senderUid == request.auth.uid ||
        resource.data.receiverUid == request.auth.uid ||
        (resource.data.participants is list && request.auth.uid in resource.data.participants) ||
        isAdmin()
      );
      allow list: if isSignedIn() && (
        resource.data.senderUid == request.auth.uid ||
        resource.data.receiverUid == request.auth.uid ||
        (resource.data.participants is list && request.auth.uid in resource.data.participants) ||
        isAdmin()
      );
      allow create: if isSignedIn()
        && isValidId(requestId)
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.receiverUid is string
        && request.resource.data.receiverUid != request.auth.uid
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.status == 'Pending';
      allow update: if isSignedIn() && (
        resource.data.senderUid == request.auth.uid ||
        resource.data.receiverUid == request.auth.uid ||
        isAdmin()
      ) && request.resource.data.senderUid == resource.data.senderUid
        && request.resource.data.receiverUid == resource.data.receiverUid
        && request.resource.data.status in ['Pending', 'Accepted', 'Rejected'];
      allow delete: if isSignedIn() && (
        resource.data.senderUid == request.auth.uid ||
        resource.data.receiverUid == request.auth.uid ||
        isAdmin()
      );
    }

    // 4. Skill Listings collection
    match /skillListings/{listingId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && isValidId(listingId)
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.skillName is string
        && request.resource.data.skillName.size() >= 1
        && request.resource.data.skillName.size() <= 100
        && request.resource.data.type in ['offered', 'wanted'];
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId;
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // 5. Exchange Requests collection
    match /exchangeRequests/{requestId} {
      allow get: if isSignedIn() && (
        resource.data.senderUid == request.auth.uid ||
        resource.data.receiverUid == request.auth.uid ||
        (resource.data.participants is list && request.auth.uid in resource.data.participants) ||
        isAdmin()
      );
      allow list: if isSignedIn() && (
        resource.data.senderUid == request.auth.uid ||
        resource.data.receiverUid == request.auth.uid ||
        (resource.data.participants is list && request.auth.uid in resource.data.participants) ||
        isAdmin()
      );
      allow create: if isSignedIn()
        && isValidId(requestId)
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.receiverUid is string
        && request.resource.data.receiverUid != request.auth.uid
        && request.resource.data.status == 'Pending'
        && request.resource.data.offeredSkill is string
        && request.resource.data.offeredSkill.size() >= 1
        && request.resource.data.offeredSkill.size() <= 120
        && request.resource.data.requestedSkill is string
        && request.resource.data.requestedSkill.size() >= 1
        && request.resource.data.requestedSkill.size() <= 120;
      allow update: if isSignedIn() && (
        resource.data.senderUid == request.auth.uid ||
        resource.data.receiverUid == request.auth.uid ||
        isAdmin()
      ) && request.resource.data.senderUid == resource.data.senderUid
        && request.resource.data.receiverUid == resource.data.receiverUid
        && request.resource.data.status in ['Pending', 'Accepted', 'Rejected', 'Cancelled', 'Completed'];
      allow delete: if isSignedIn() && (
        resource.data.senderUid == request.auth.uid ||
        resource.data.receiverUid == request.auth.uid ||
        isAdmin()
      );
    }

    // Helper to verify whether the current user is one of the two UIDs in a direct chat ID (dm_<uid1>_<uid2>)
    function isDirectChatMemberById(chatId) {
      return chatId.matches('^dm_[a-zA-Z0-9]+_[a-zA-Z0-9]+$') &&
        request.auth.uid in chatId.split('_');
    }

    function isDocChatParticipant(chatData) {
      return chatData != null && (
        ('participants' in chatData && chatData.participants is list && request.auth.uid in chatData.participants) ||
        ('members' in chatData && chatData.members is list && request.auth.uid in chatData.members)
      );
    }

    // Helper to safely verify chat participation without null dereference or redundant get() calls
    function isChatParticipant(chatId) {
      return isDirectChatMemberById(chatId) || (
        exists(/databases/$(database)/documents/chats/$(chatId)) &&
        isDocChatParticipant(get(/databases/$(database)/documents/chats/$(chatId)).data)
      );
    }

    // 6. Chats & Messages (Participant-only access)
    match /chats/{chatId} {
      allow get: if isSignedIn() && (
        resource == null ||
        isDirectChatMemberById(chatId) ||
        isDocChatParticipant(resource.data) ||
        isAdmin()
      );
      allow list: if isSignedIn() && (
        request.auth.uid in resource.data.participants ||
        isDirectChatMemberById(chatId) ||
        isDocChatParticipant(resource.data) ||
        isAdmin()
      );
      allow create: if isSignedIn()
        && isValidId(chatId)
        && request.resource.data.participants is list
        && request.resource.data.participants.size() >= 1
        && request.resource.data.participants.size() <= 50
        && request.auth.uid in request.resource.data.participants;
      allow update: if isSignedIn() && (
        isDirectChatMemberById(chatId) ||
        isDocChatParticipant(resource.data) ||
        (request.resource.data.participants is list && request.auth.uid in request.resource.data.participants) ||
        isAdmin()
      );
      allow delete: if isSignedIn() && (
        isDirectChatMemberById(chatId) ||
        isDocChatParticipant(resource.data) ||
        isAdmin()
      );

      match /messages/{messageId} {
        allow get, list: if isSignedIn() && (
          isDirectChatMemberById(chatId) ||
          isChatParticipant(chatId) ||
          ('participants' in resource.data && request.auth.uid in resource.data.participants) ||
          resource.data.senderUid == request.auth.uid ||
          ('receiverUid' in resource.data && resource.data.receiverUid == request.auth.uid) ||
          isAdmin()
        );
        allow create: if isSignedIn()
          && isValidId(messageId)
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 2000
          && (
            isDirectChatMemberById(chatId) ||
            isChatParticipant(chatId) ||
            ('participants' in request.resource.data &&
              request.resource.data.participants is list &&
              request.auth.uid in request.resource.data.participants) ||
            isAdmin()
          );
        allow update: if isSignedIn()
          && (
            isDirectChatMemberById(chatId) ||
            isChatParticipant(chatId) ||
            ('participants' in resource.data && request.auth.uid in resource.data.participants) ||
            resource.data.senderUid == request.auth.uid ||
            ('receiverUid' in resource.data && resource.data.receiverUid == request.auth.uid) ||
            isAdmin()
          )
          && request.resource.data.senderUid == resource.data.senderUid
          && request.resource.data.text == resource.data.text;
        allow delete: if isSignedIn() && (
          resource.data.senderUid == request.auth.uid ||
          isDirectChatMemberById(chatId) ||
          isChatParticipant(chatId) ||
          isAdmin()
        );
      }
    }

    // 7. Mentoring & Learning Sessions
    match /sessions/{sessionId} {
      allow get, list: if isSignedIn() && (
        resource.data.hostUid == request.auth.uid ||
        resource.data.participantUid == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn()
        && isValidId(sessionId)
        && (request.resource.data.hostUid == request.auth.uid || request.resource.data.participantUid == request.auth.uid)
        && request.resource.data.topic is string
        && request.resource.data.topic.size() >= 1
        && request.resource.data.topic.size() <= 200
        && request.resource.data.status == 'Pending';
      allow update: if isSignedIn() && (
        resource.data.hostUid == request.auth.uid ||
        resource.data.participantUid == request.auth.uid
      ) && request.resource.data.hostUid == resource.data.hostUid
        && request.resource.data.participantUid == resource.data.participantUid
        && request.resource.data.status in ['Pending', 'Accepted', 'Rejected', 'Cancelled', 'Completed'];
      allow delete: if isAdmin();
    }

    // 8. Projects & Project Invitations
    match /projects/{projectId} {
      allow get, list: if isSignedIn() && (
        !('visibility' in resource.data) ||
        resource.data.visibility == 'public' ||
        resource.data.authorId == request.auth.uid ||
        (resource.data.teamMembers is list && request.auth.uid in resource.data.teamMembers) ||
        isAdmin()
      );
      allow create: if isSignedIn()
        && isValidId(projectId)
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 1
        && request.resource.data.title.size() <= 150
        && request.resource.data.description is string
        && request.resource.data.description.size() >= 1
        && request.resource.data.description.size() <= 2000;
      allow update: if isSignedIn() && (
        resource.data.authorId == request.auth.uid ||
        (resource.data.teamMembers is list && request.auth.uid in resource.data.teamMembers) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'upvotedBy', 'updatedAt']) ||
        isAdmin()
      ) && request.resource.data.authorId == resource.data.authorId;
      allow delete: if isSignedIn() && (resource.data.authorId == request.auth.uid || isAdmin());
    }

    match /projectInvitations/{invitationId} {
      allow get, list: if isSignedIn() && (
        resource.data.senderId == request.auth.uid ||
        resource.data.receiverId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn()
        && isValidId(invitationId)
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.status == 'Pending';
      allow update: if isSignedIn() && (
        resource.data.senderId == request.auth.uid ||
        resource.data.receiverId == request.auth.uid
      ) && request.resource.data.senderId == resource.data.senderId
        && request.resource.data.receiverId == resource.data.receiverId
        && request.resource.data.status in ['Pending', 'Accepted', 'Rejected'];
      allow delete: if isAdmin();
    }

    // 9. Learning Resources
    match /resources/{resourceId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && isValidId(resourceId)
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 1
        && request.resource.data.title.size() <= 150
        && request.resource.data.externalUrl is string
        && request.resource.data.externalUrl.size() >= 1
        && request.resource.data.externalUrl.size() <= 1000;
      allow update: if isSignedIn()
        && resource.data.authorUid == request.auth.uid
        && request.resource.data.authorUid == resource.data.authorUid;
      allow delete: if isSignedIn() && (resource.data.authorUid == request.auth.uid || isAdmin());
    }

    // 10. Notifications (Recipient-only read & mark read; any signed-in user can trigger notification creation)
    match /notifications/{notificationId} {
      allow get, list: if isSignedIn() && (
        resource.data.recipientUid == request.auth.uid || isAdmin()
      );
      allow create: if isSignedIn()
        && isValidId(notificationId)
        && request.resource.data.recipientUid is string
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 1
        && request.resource.data.title.size() <= 150
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 1
        && request.resource.data.message.size() <= 500;
      allow update: if isSignedIn()
        && resource.data.recipientUid == request.auth.uid
        && request.resource.data.recipientUid == resource.data.recipientUid;
      allow delete: if isSignedIn() && (resource.data.recipientUid == request.auth.uid || isAdmin());
    }

    // 11. Moderation Reports (Reporters can create; only Admins can review/manage)
    match /reports/{reportId} {
      allow get, list: if isAdmin() || (isSignedIn() && resource.data.reporterUid == request.auth.uid);
      allow create: if isSignedIn()
        && isValidId(reportId)
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 1
        && request.resource.data.reason.size() <= 1000
        && request.resource.data.status == 'Open';
      allow update, delete: if isAdmin();
    }
  }
}
