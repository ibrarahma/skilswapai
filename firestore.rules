rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Default Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Core Reusable Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email == "ibrarahmadansare@gmail.com" && request.auth.token.email_verified == true)
      );
    }

    // 1. Admins lookup collection (read-only for self/admin, never client-writable)
    match /admins/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();
      allow create, update, delete: if false;
    }

    // 2. Users collection
    match /users/{uid} {
      allow read: if isSignedIn();

      // Public registration can ONLY assign 'student' or 'teacher'
      allow create: if isOwner(uid)
        && isValidId(uid)
        && request.resource.data.role in ['student', 'teacher']
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 100
        && request.resource.data.email is string
        && request.resource.data.email.size() >= 3
        && request.resource.data.email.size() <= 254;

      // Users can update their own profile but can NEVER change their role; admins can manage profiles
      allow update: if (
        isOwner(uid)
        && request.resource.data.role == resource.data.role
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 100
      ) || isAdmin();

      allow delete: if isAdmin();
    }

    // 3. Skill Listings collection
    match /skillListings/{listingId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && isValidId(listingId)
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.skillName is string
        && request.resource.data.skillName.size() >= 1
        && request.resource.data.skillName.size() <= 100
        && request.resource.data.type in ['offered', 'wanted'];
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId;
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // 4. Exchange Requests collection
    match /exchangeRequests/{requestId} {
      allow get: if isSignedIn() && (
        resource.data.senderUid == request.auth.uid ||
        resource.data.receiverUid == request.auth.uid ||
        isAdmin()
      );
      allow list: if isSignedIn() && (
        resource.data.senderUid == request.auth.uid ||
        resource.data.receiverUid == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn()
        && isValidId(requestId)
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.receiverUid is string
        && request.resource.data.receiverUid != request.auth.uid
        && request.resource.data.status == 'Pending'
        && request.resource.data.offeredSkill is string
        && request.resource.data.offeredSkill.size() >= 1
        && request.resource.data.offeredSkill.size() <= 120
        && request.resource.data.requestedSkill is string
        && request.resource.data.requestedSkill.size() >= 1
        && request.resource.data.requestedSkill.size() <= 120;
      allow update: if isSignedIn() && (
        resource.data.senderUid == request.auth.uid ||
        resource.data.receiverUid == request.auth.uid
      ) && request.resource.data.senderUid == resource.data.senderUid
        && request.resource.data.receiverUid == resource.data.receiverUid
        && request.resource.data.status in ['Pending', 'Accepted', 'Rejected', 'Cancelled', 'Completed'];
      allow delete: if isAdmin();
    }

    // 5. Chats & Messages (Participant-only access)
    match /chats/{chatId} {
      allow get: if isSignedIn() && (request.auth.uid in resource.data.participants || isAdmin());
      allow list: if isSignedIn() && (request.auth.uid in resource.data.participants || isAdmin());
      allow create: if isSignedIn()
        && isValidId(chatId)
        && request.resource.data.participants is list
        && request.resource.data.participants.size() >= 1
        && request.resource.data.participants.size() <= 50
        && request.auth.uid in request.resource.data.participants;
      allow update: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isSignedIn() && (
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants ||
          isAdmin()
        );
        allow create: if isSignedIn()
          && isValidId(messageId)
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 2000;
        allow update: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
          && request.resource.data.senderUid == resource.data.senderUid
          && request.resource.data.text == resource.data.text;
        allow delete: if isAdmin();
      }
    }

    // 6. Mentoring & Learning Sessions
    match /sessions/{sessionId} {
      allow get, list: if isSignedIn() && (
        resource.data.hostUid == request.auth.uid ||
        resource.data.participantUid == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn()
        && isValidId(sessionId)
        && (request.resource.data.hostUid == request.auth.uid || request.resource.data.participantUid == request.auth.uid)
        && request.resource.data.topic is string
        && request.resource.data.topic.size() >= 1
        && request.resource.data.topic.size() <= 200
        && request.resource.data.status == 'Pending';
      allow update: if isSignedIn() && (
        resource.data.hostUid == request.auth.uid ||
        resource.data.participantUid == request.auth.uid
      ) && request.resource.data.hostUid == resource.data.hostUid
        && request.resource.data.participantUid == resource.data.participantUid
        && request.resource.data.status in ['Pending', 'Accepted', 'Rejected', 'Cancelled', 'Completed'];
      allow delete: if isAdmin();
    }

    // 7. Projects & Project Invitations
    match /projects/{projectId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && isValidId(projectId)
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 1
        && request.resource.data.title.size() <= 150
        && request.resource.data.description is string
        && request.resource.data.description.size() >= 1
        && request.resource.data.description.size() <= 2000;
      allow update: if isSignedIn() && (
        resource.data.authorId == request.auth.uid ||
        (resource.data.teamMembers is list && request.auth.uid in resource.data.teamMembers) ||
        isAdmin()
      ) && request.resource.data.authorId == resource.data.authorId;
      allow delete: if isSignedIn() && (resource.data.authorId == request.auth.uid || isAdmin());
    }

    match /projectInvitations/{invitationId} {
      allow get, list: if isSignedIn() && (
        resource.data.senderId == request.auth.uid ||
        resource.data.receiverId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn()
        && isValidId(invitationId)
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.status == 'Pending';
      allow update: if isSignedIn() && (
        resource.data.senderId == request.auth.uid ||
        resource.data.receiverId == request.auth.uid
      ) && request.resource.data.senderId == resource.data.senderId
        && request.resource.data.receiverId == resource.data.receiverId
        && request.resource.data.status in ['Pending', 'Accepted', 'Rejected'];
      allow delete: if isAdmin();
    }

    // 8. Learning Resources
    match /resources/{resourceId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && isValidId(resourceId)
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 1
        && request.resource.data.title.size() <= 150
        && request.resource.data.externalUrl is string
        && request.resource.data.externalUrl.size() >= 1
        && request.resource.data.externalUrl.size() <= 1000;
      allow update: if isSignedIn()
        && resource.data.authorUid == request.auth.uid
        && request.resource.data.authorUid == resource.data.authorUid;
      allow delete: if isSignedIn() && (resource.data.authorUid == request.auth.uid || isAdmin());
    }

    // 9. Notifications (Recipient-only read & mark read; any signed-in user can trigger notification creation)
    match /notifications/{notificationId} {
      allow get, list: if isSignedIn() && (
        resource.data.recipientUid == request.auth.uid || isAdmin()
      );
      allow create: if isSignedIn()
        && isValidId(notificationId)
        && request.resource.data.recipientUid is string
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 1
        && request.resource.data.title.size() <= 150
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 1
        && request.resource.data.message.size() <= 500;
      allow update: if isSignedIn()
        && resource.data.recipientUid == request.auth.uid
        && request.resource.data.recipientUid == resource.data.recipientUid;
      allow delete: if isSignedIn() && (resource.data.recipientUid == request.auth.uid || isAdmin());
    }

    // 10. Moderation Reports (Reporters can create; only Admins can review/manage)
    match /reports/{reportId} {
      allow get, list: if isAdmin() || (isSignedIn() && resource.data.reporterUid == request.auth.uid);
      allow create: if isSignedIn()
        && isValidId(reportId)
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 1
        && request.resource.data.reason.size() <= 1000
        && request.resource.data.status == 'Open';
      allow update, delete: if isAdmin();
    }
  }
}
