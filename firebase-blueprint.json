{
  "entities": {
    "User": {
      "title": "User",
      "description": "Student, Teacher/Professor, Mentor, Recruiter, or Admin user profile",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Full display name",
          "minLength": 1,
          "maxLength": 100
        },
        "username": {
          "type": "string",
          "description": "Unique handle",
          "minLength": 1,
          "maxLength": 60
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "User email address",
          "minLength": 3,
          "maxLength": 254
        },
        "role": {
          "type": "string",
          "description": "Platform role",
          "enum": ["student", "teacher", "mentor", "recruiter", "admin"]
        },
        "college": {
          "type": "string",
          "description": "College or institution name",
          "maxLength": 150
        },
        "institution": {
          "type": "string",
          "description": "Institution name for teachers/professors",
          "maxLength": 150
        },
        "department": {
          "type": "string",
          "description": "Academic department",
          "maxLength": 120
        },
        "course": {
          "type": "string",
          "description": "Degree or course program for students",
          "maxLength": 120
        },
        "semester": {
          "type": "number",
          "description": "Current semester for students"
        },
        "designation": {
          "type": "string",
          "description": "Academic title or designation for teachers",
          "maxLength": 120
        },
        "experience": {
          "type": "string",
          "description": "Teaching/industry experience summary",
          "maxLength": 500
        },
        "bio": {
          "type": "string",
          "description": "Biography",
          "maxLength": 1000
        },
        "learningGoals": {
          "type": "string",
          "description": "Student learning objectives",
          "maxLength": 600
        },
        "availability": {
          "type": "string",
          "description": "Teacher mentoring availability schedule",
          "maxLength": 200
        },
        "phoneNumber": {
          "type": "string",
          "description": "Private contact phone number",
          "maxLength": 25
        },
        "avatar": {
          "type": "string",
          "description": "Profile photo URL",
          "maxLength": 1000
        },
        "skillsToTeach": {
          "type": "array",
          "description": "Skills offered"
        },
        "skillsToLearn": {
          "type": "array",
          "description": "Skills wanted"
        },
        "subjectsAndExpertise": {
          "type": "array",
          "description": "Teacher subjects and expertise areas"
        },
        "mentoringInterests": {
          "type": "array",
          "description": "Teacher mentoring topics"
        },
        "interests": {
          "type": "array",
          "description": "General academic/technical interests"
        },
        "profileCompleted": {
          "type": "boolean",
          "description": "Whether role onboarding is completed"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        }
      },
      "required": ["name", "username", "email", "role"]
    },
    "ConnectionRequest": {
      "title": "ConnectionRequest",
      "description": "Student-Teacher and peer connection request and relationship record",
      "type": "object",
      "properties": {
        "senderUid": { "type": "string", "maxLength": 128 },
        "senderName": { "type": "string", "maxLength": 100 },
        "senderUsername": { "type": "string", "maxLength": 60 },
        "senderAvatar": { "type": "string", "maxLength": 1000 },
        "senderRole": { "type": "string", "enum": ["student", "teacher", "mentor", "recruiter", "admin"] },
        "senderCollege": { "type": "string", "maxLength": 150 },
        "senderDepartment": { "type": "string", "maxLength": 120 },
        "receiverUid": { "type": "string", "maxLength": 128 },
        "receiverName": { "type": "string", "maxLength": 100 },
        "receiverUsername": { "type": "string", "maxLength": 60 },
        "receiverAvatar": { "type": "string", "maxLength": 1000 },
        "receiverRole": { "type": "string", "enum": ["student", "teacher", "mentor", "recruiter", "admin"] },
        "receiverCollege": { "type": "string", "maxLength": 150 },
        "receiverDepartment": { "type": "string", "maxLength": 120 },
        "participants": { "type": "array", "description": "Two-element array [senderUid, receiverUid]" },
        "status": { "type": "string", "enum": ["Pending", "Accepted", "Rejected"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["senderUid", "receiverUid", "participants", "status"]
    },
    "SkillListing": {
      "title": "SkillListing",
      "description": "Marketplace skill listing offered or wanted by a user",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 100 },
        "username": { "type": "string", "maxLength": 60 },
        "userRole": { "type": "string", "enum": ["student", "teacher", "mentor", "recruiter", "admin"] },
        "institution": { "type": "string", "maxLength": 150 },
        "skillName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "category": { "type": "string", "maxLength": 60 },
        "level": { "type": "string", "enum": ["Beginner", "Intermediate", "Advanced", "Expert"] },
        "type": { "type": "string", "enum": ["offered", "wanted"] },
        "description": { "type": "string", "maxLength": 600 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "skillName", "category", "level", "type"]
    },
    "ExchangeRequest": {
      "title": "ExchangeRequest",
      "description": "Peer-to-peer skill exchange request between two users",
      "type": "object",
      "properties": {
        "senderUid": { "type": "string", "maxLength": 128 },
        "senderName": { "type": "string", "maxLength": 100 },
        "senderAvatar": { "type": "string", "maxLength": 1000 },
        "receiverUid": { "type": "string", "maxLength": 128 },
        "receiverName": { "type": "string", "maxLength": 100 },
        "receiverAvatar": { "type": "string", "maxLength": 1000 },
        "participants": { "type": "array", "description": "Array of [senderUid, receiverUid]" },
        "offeredSkill": { "type": "string", "minLength": 1, "maxLength": 120 },
        "requestedSkill": { "type": "string", "minLength": 1, "maxLength": 120 },
        "message": { "type": "string", "maxLength": 1000 },
        "status": {
          "type": "string",
          "enum": ["Pending", "Accepted", "Rejected", "Cancelled", "Completed"]
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["senderUid", "receiverUid", "offeredSkill", "requestedSkill", "status"]
    },
    "Chat": {
      "title": "Chat",
      "description": "One-to-one or project group conversation metadata",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 120 },
        "type": { "type": "string", "enum": ["direct", "group"] },
        "participants": { "type": "array", "description": "Array of participant UIDs" },
        "projectId": { "type": "string", "maxLength": 128 },
        "lastMessage": { "type": "string", "maxLength": 500 },
        "lastMessageTime": { "type": "string", "maxLength": 60 },
        "lastSenderUid": { "type": "string", "maxLength": 128 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["type", "participants"]
    },
    "Message": {
      "title": "Message",
      "description": "Message inside a chat conversation",
      "type": "object",
      "properties": {
        "chatId": { "type": "string", "maxLength": 128 },
        "senderUid": { "type": "string", "maxLength": 128 },
        "receiverUid": { "type": "string", "maxLength": 128 },
        "participants": { "type": "array", "description": "Array of participant UIDs in this conversation" },
        "senderName": { "type": "string", "maxLength": 100 },
        "senderAvatar": { "type": "string", "maxLength": 1000 },
        "text": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "type": { "type": "string", "enum": ["text", "file", "voice"] },
        "fileUrl": { "type": "string", "maxLength": 2000 },
        "fileName": { "type": "string", "maxLength": 200 },
        "audioDuration": { "type": "string", "maxLength": 20 },
        "readBy": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["chatId", "senderUid", "text"]
    },
    "Session": {
      "title": "Session",
      "description": "Mentoring or skill-exchange learning session",
      "type": "object",
      "properties": {
        "hostUid": { "type": "string", "maxLength": 128 },
        "participantUid": { "type": "string", "maxLength": 128 },
        "topic": { "type": "string", "minLength": 1, "maxLength": 200 },
        "scheduledDate": { "type": "string", "maxLength": 40 },
        "scheduledTime": { "type": "string", "maxLength": 40 },
        "meetLink": { "type": "string", "maxLength": 500 },
        "status": {
          "type": "string",
          "enum": ["Pending", "Accepted", "Rejected", "Cancelled", "Completed"]
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["hostUid", "participantUid", "topic", "status"]
    },
    "Project": {
      "title": "Project",
      "description": "Student or faculty collaborative project",
      "type": "object",
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 150 },
        "description": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "category": { "type": "string", "maxLength": 60 },
        "authorId": { "type": "string", "maxLength": 128 },
        "authorName": { "type": "string", "maxLength": 100 },
        "authorUsername": { "type": "string", "maxLength": 60 },
        "authorAvatar": { "type": "string", "maxLength": 1000 },
        "authorRole": { "type": "string", "maxLength": 40 },
        "college": { "type": "string", "maxLength": 150 },
        "department": { "type": "string", "maxLength": 120 },
        "status": { "type": "string", "enum": ["Idea", "In Progress", "Completed"] },
        "visibility": { "type": "string", "enum": ["public", "private"] },
        "published": { "type": "boolean" },
        "techStack": { "type": "array" },
        "requiredSkills": { "type": "array" },
        "teamMembers": { "type": "array" },
        "files": { "type": "array" },
        "tasks": { "type": "array" },
        "milestones": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "description", "authorId", "status"]
    },
    "ProjectInvitation": {
      "title": "ProjectInvitation",
      "description": "Invitation to join a project team",
      "type": "object",
      "properties": {
        "projectId": { "type": "string", "maxLength": 128 },
        "senderId": { "type": "string", "maxLength": 128 },
        "receiverId": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "enum": ["Pending", "Accepted", "Rejected"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["projectId", "senderId", "receiverId", "status"]
    },
    "Resource": {
      "title": "Resource",
      "description": "Educational resource (notes, PDF link, tutorial, documentation)",
      "type": "object",
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 150 },
        "description": { "type": "string", "maxLength": 1000 },
        "category": {
          "type": "string",
          "enum": ["Notes", "PDFs", "Tutorials", "External Links", "Project Docs"]
        },
        "externalUrl": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "authorUid": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "category", "externalUrl", "authorUid"]
    },
    "Notification": {
      "title": "Notification",
      "description": "In-app user notification record",
      "type": "object",
      "properties": {
        "recipientUid": { "type": "string", "maxLength": 128 },
        "senderUid": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "minLength": 1, "maxLength": 150 },
        "message": { "type": "string", "minLength": 1, "maxLength": 500 },
        "read": { "type": "boolean" },
        "type": {
          "type": "string",
          "enum": ["swap", "team", "project", "hackathon", "admin", "session", "chat"]
        },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["recipientUid", "title", "message", "read", "type"]
    },
    "Report": {
      "title": "Report",
      "description": "User or content moderation report",
      "type": "object",
      "properties": {
        "reporterUid": { "type": "string", "maxLength": 128 },
        "targetType": { "type": "string", "enum": ["user", "project", "message", "resource"] },
        "targetId": { "type": "string", "maxLength": 128 },
        "reason": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "status": { "type": "string", "enum": ["Open", "Reviewed", "Resolved", "Dismissed"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["reporterUid", "targetType", "targetId", "reason", "status"]
    }
  },
  "firestore": {
    "/users/{uid}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profiles indexed by Firebase Auth UID"
    },
    "/connectionRequests/{requestId}": {
      "schema": { "$ref": "#/entities/ConnectionRequest" },
      "description": "Student-Teacher and peer connection requests and accepted connections"
    },
    "/skillListings/{listingId}": {
      "schema": { "$ref": "#/entities/SkillListing" },
      "description": "Skills offered and wanted marketplace listings"
    },
    "/exchangeRequests/{requestId}": {
      "schema": { "$ref": "#/entities/ExchangeRequest" },
      "description": "Peer skill exchange requests"
    },
    "/chats/{chatId}": {
      "schema": { "$ref": "#/entities/Chat" },
      "description": "One-to-one and project group chat metadata"
    },
    "/chats/{chatId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/Message" },
      "description": "Messages belonging to a chat conversation"
    },
    "/sessions/{sessionId}": {
      "schema": { "$ref": "#/entities/Session" },
      "description": "Scheduled mentoring and skill exchange sessions"
    },
    "/projects/{projectId}": {
      "schema": { "$ref": "#/entities/Project" },
      "description": "Collaborative student and faculty projects"
    },
    "/projectInvitations/{invitationId}": {
      "schema": { "$ref": "#/entities/ProjectInvitation" },
      "description": "Team collaboration invitations for projects"
    },
    "/resources/{resourceId}": {
      "schema": { "$ref": "#/entities/Resource" },
      "description": "Shared learning notes, PDFs, tutorials, and links"
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/Notification" },
      "description": "In-app notifications per user"
    },
    "/reports/{reportId}": {
      "schema": { "$ref": "#/entities/Report" },
      "description": "Platform moderation reports"
    }
  }
}
